OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini
CORS_ORIGIN=https://byoh5.github.io
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=8
OPENAI_MAX_OUTPUT_TOKENS=480
# JSON 파싱 실패 시 1회 재시도에 사용할 상한
OPENAI_MAX_OUTPUT_TOKENS_RETRY=960
OPENAI_PROMPT_CACHE_KEY=asset-report-v2
# Optional: in_memory or 24h (model support dependent)
OPENAI_PROMPT_CACHE_RETENTION=in_memory
OPENAI_RESPONSE_CACHE_TTL_MS=300000
